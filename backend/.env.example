# Environment Configuration for CCIS Prescription Module
NODE_ENV=development
PORT=5000

# Central MongoDB URI (Do not commit production credentials to Git)
MONGO_URI=mongodb://localhost:27017/ccis_db

# Shared Authentication Secret
JWT_SECRET=ccis_shared_jwt_super_secret_key_development_only

# Module Service URLs (For Inter-module REST communication if needed)
PHARMACY_SERVICE_URL=http://localhost:5001/api/pharmacy
CLINICAL_RECORDS_SERVICE_URL=http://localhost:5002/api/clinical-records
PATIENT_SERVICE_URL=http://localhost:5003/api/patients

# CORS Allowed Origins
CLIENT_ORIGIN=http://localhost:3000
